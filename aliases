# Git aliases

git_squash() {
    msg=$(git show --format=%B -s)
    git reset --soft $(git merge-base @ $1)
    git commit --message $msg
}

alias gsq='git_squash'
alias gcar='git commit -v -a --no-edit --reset-author --amend'
alias gcoh='git reflog show | grep checkout | head'
alias gcundo='git reset --soft HEAD~1'

# indirs

in_directories() {
    for dir in *; do
        if [ -d $dir ]; then
            pushd $dir > /dev/null
            echo
            echo 📂 $dir
            eval "$1" || true
            popd > /dev/null
        fi
    done
}

alias indirs=in_directories
